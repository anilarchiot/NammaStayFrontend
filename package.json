{
  "name": "nammastay-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "NammaStay website and Windows desktop app",
  "author": "NammaStay",
  "engines": {
    "node": ">=20"
  },
  "main": "scripts/desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/serve-local.cjs",
    "desktop:dev": "electron .",
    "desktop:build:win": "electron-builder --win nsis --publish never",
    "mobile:build-web": "node scripts/build-mobile-web.cjs",
    "mobile:sync": "npm run mobile:build-web && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:run:android": "npm run mobile:sync && cap run android",
    "mobile:run:ios": "npm run mobile:sync && cap run ios",
    "build": "node scripts/validate-production.cjs",
    "validate:production": "node scripts/validate-production.cjs",
    "test:desktop": "node --test scripts/desktop/*.test.cjs",
    "test": "npm run build && npm run test:desktop && npm run mobile:build-web"
  },
  "build": {
    "appId": "com.nammastay.desktop",
    "productName": "NammaStay",
    "asar": true,
    "files": [
      "*.html",
      "*.js",
      "assets/**/*",
      "scripts/desktop/**/*",
      "scripts/local-server.cjs",
      "CNAME",
      "_headers",
      "robots.txt"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "sql.js": "^1.15.1"
  }
}
